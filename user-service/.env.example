# PostgreSQL running on the host at port 5433
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Google OAuth 2.0 web client credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Paths for running the service locally; Compose overrides these with container paths.
JWT_PRIVATE_KEY_LOCATION=keys/privateKey.pem
JWT_PUBLIC_KEY_LOCATION=keys/publicKey.pem
